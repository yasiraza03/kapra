{
  "name": "kapra",
  "version": "0.0.0",
  "private": true,
  "description": "A garment forensics instrument — reconstructs a garment's genome from photographs using real computer vision, and tells you exactly how confident it is and why.",
  "author": "yr10raza@gmail.com",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.10.0",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "schema:build": "pnpm --filter @kapra/genome-schema build",
    "web": "pnpm --filter @kapra/web dev",
    "engine": "python -m uvicorn kapra_engine.main:app --app-dir apps/engine/src --reload --port 8000"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
