{
  "name": "@kapra/genome-schema",
  "version": "1.0.0",
  "description": "The versioned kapra Genome schema — the single source of truth shared by the web app and the engine.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./validate": {
      "types": "./dist/validate.d.ts",
      "import": "./dist/validate.js"
    },
    "./schema": "./schema/genome.schema.v1.json"
  },
  "files": ["dist", "schema"],
  "scripts": {
    "generate": "node scripts/generate-types.mjs",
    "build": "pnpm generate && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test",
    "lint": "echo \"(genome-schema) lint: no-op\""
  },
  "devDependencies": {
    "json-schema-to-typescript": "^15.0.3",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  }
}
